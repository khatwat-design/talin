# Talin Beauty — نسخ إلى .env.local وعدّل القيم (لا ترفع الأسرار إلى Git)

# --- عام (واجهة) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# عملة وعرض محلي في الواجهة (الافتراضي في الكود: USD)
NEXT_PUBLIC_STORE_CURRENCY=USD
NEXT_PUBLIC_STORE_LOCALE=ar-SY

# إخفاء السعر في المتجر وإظهار "???" — ضع false
# NEXT_PUBLIC_SHOW_PRODUCT_PRICES=false

# --- تلجرام (إلزامي لإتمام الطلب من /api/checkout) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Google Sheets (اختياري) ---
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# --- واتساب ---
NEXT_PUBLIC_WHATSAPP_NUMBER=+963980906364
NEXT_PUBLIC_WHATSAPP_MESSAGE=مرحباً، أريد الاستفسار عن زيت تالين بيوتي

# --- التواصل الاجتماعي ---
